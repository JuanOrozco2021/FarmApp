# Copia este archivo a .env y ajusta los valores para tu ambiente.
# docker-compose los toma automaticamente; en IntelliJ, configuralos
# como variables de entorno de la Run Configuration del backend.

DB_NAME=boticario
DB_USER=boticario
DB_PASSWORD=boticario
DB_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200

# Minimo 32 caracteres. Genera uno propio para cualquier ambiente real.
JWT_SECRET=change-this-development-only-secret-key-please-min-32-chars

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Usuario administrador inicial (se crea solo si la tabla users esta vacia).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@boticario.local
